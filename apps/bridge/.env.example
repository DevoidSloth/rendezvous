# --- Shared with the agent server -------------------------------------------
# Same value on both sides; sent as X-Bridge-Secret in both directions.
BRIDGE_SECRET=change-me
# Where the TypeScript agent server listens.
AGENT_URL=http://localhost:8787
# Port for this bridge (the agent server should POST to http://localhost:8765/calls).
BRIDGE_PORT=8765

# --- xAI / Grok Voice ---------------------------------------------------------
XAI_API_KEY=
# Lowercase built-in voice id (e.g. eve, rex) or a custom voice id; list via GET /v1/tts/voices.
GROK_VOICE=rex
# GROK_MODEL=grok-voice-latest

# --- Twilio -------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +16075550100
TWILIO_FROM_NUMBER=
# Public host Twilio uses to reach this bridge, no scheme: e.g. abc123.ngrok-free.app
PUBLIC_HOST=
# Set to false only if status callbacks are rejected while debugging ngrok.
VALIDATE_TWILIO_SIGNATURE=true

# --- Tuning (optional) --------------------------------------------------------
# FILLER_INTERVAL_SECS=15
# ASK_GROUP_HTTP_TIMEOUT_SECS=75
# MAX_CALL_SECS=600
# SIMULATE_STEP_DELAY_SECS=1
