# Name people mention in the chat ("@Rendezvous dinner tonight").
AGENT_NAME=Rendezvous
PORT=8787

# Photon (app.photon.codes → Settings). Group chats need the Business plan's dedicated line.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# xAI. Without a key, the built-in parsers read requests instead.
XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning

# Capital One Nessie. Without a key, a mock ledger stands in ($60 per account).
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Google Routes API (walking times). Without it, an offline estimate is used.
GOOGLE_MAPS_API_KEY=
# Service account JSON for free/busy. Each member shares "See only free/busy" with its email.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Python call bridge (apps/bridge). Same secret on both sides.
BRIDGE_URL=http://localhost:8765
BRIDGE_SECRET=change-me
# Every venue call dials this number (a teammate playing the host). Use "simulate" for the bridge's scripted host.
DEMO_HOST_PHONE=
# Hidden chat command that sends departure DMs right away during the demo.
FAST_FORWARD_COMMAND=!go
